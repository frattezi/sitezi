{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitezi",
  "compatibility_date": "2026-09-30",

  // Static assets only: no Worker script, no bindings. The build output is
  // served straight from the edge. See README → Deploy.
  "assets": {
    "directory": "./dist",
    // Unknown paths return dist/404.html (built from src/pages/404.astro)
    // instead of an empty 200.
    "not_found_handling": "404-page",
  },

  "observability": {
    "enabled": true,
  },
}
