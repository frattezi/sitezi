---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Blog">
  <h1 class="text-3xl font-semibold tracking-tight text-neutral-900">Blog</h1>

  {posts.length === 0 ? (
    <p class="mt-6 text-neutral-600">Nothing published yet.</p>
  ) : (
    <ul class="mt-10 space-y-8">
      {posts.map((post) => (
        <li>
          <article>
            <h2 class="text-xl font-medium">
              <a href={`/blog/${post.id}/`} class="text-neutral-900 hover:underline">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-1 text-sm text-neutral-500">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </p>
            <p class="mt-2 text-neutral-600">{post.data.description}</p>
          </article>
        </li>
      ))}
    </ul>
  )}
</Base>
