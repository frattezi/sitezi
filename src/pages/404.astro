---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <h1 class="text-3xl font-semibold tracking-tight text-neutral-900">Page not found</h1>

  <p class="mt-4 text-neutral-600">
    That URL does not exist. It may have moved, or it may never have been here.
  </p>

  <p class="mt-6">
    <a href="/" class="text-neutral-900 underline underline-offset-4">
      Back home
    </a>
  </p>
</Base>
